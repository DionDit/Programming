<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        xmlns:VM="clr-namespace:View.ViewModels"
        xmlns:converters="clr-namespace:View.Converters"
        mc:Ignorable="d"
        Icon="/ContactsApp_96x96.ico"
        Title="Contacts" 
        Height="600" 
        Width="700"
        MinHeight="400"
        MinWidth="500">
    <Window.DataContext>
        <VM:MainWindowViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Background="#f8f8f8">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" 
                                   Content="Find:" 
                                   Padding="5,0,5,0"
                                   VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     VerticalAlignment="Center"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <ListBox Grid.Row="1" 
                                 Margin="0,0,0,8"
                                 ItemsSource="{Binding FilteredContacts}"
                                 SelectedItem="{Binding SelectedContact}"
                                 DisplayMemberPath="Name"/>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" 
                                    Content="Add" 
                                    Height="25" 
                                    Margin="0,0,3,0"
                                    Command="{Binding AddCommand}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Add random contact" 
                                                  Command="{Binding AddRandomCommand}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Grid.Column="1" 
                                    Content="Edit" 
                                    Height="25" 
                                    Margin="3,0,3,0"
                                    Command="{Binding EditCommand}"/>
                            <Button Grid.Column="2" 
                                    Content="Remove" 
                                    Height="25" 
                                    Margin="3,0,0,0"
                                    Command="{Binding RemoveCommand}"/>
                        </Grid>
                    </Grid>
                </Grid>
                <GridSplitter Grid.Column="1" 
                              Width="3" 
                              Background="White"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"/>
                <Grid Grid.Column="2" Background="White">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="100"
                                    Height="100"
                                    Margin="0,18,10,0"
                                    VerticalAlignment="Top"
                                    Cursor="Hand"
                                    ToolTip="Нажмите для выбора фото">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding SelectPhotoCommand}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Image Source="{Binding PhotoBytes, Converter={StaticResource ByteArrayToImageConverter}}"
                                           Width="100"
                                           Height="100"
                                           Stretch="UniformToFill"
                                           Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <Image Source="/photo_placeholder_100x100.png"
                                           Width="100"
                                           Height="100"
                                           Stretch="UniformToFill"
                                           Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" 
                                        VerticalAlignment="Top">
                                <Label Content="Name:" 
                                       Padding="0,0,0,2"/>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding IsReadOnly}"
                                         Margin="0,0,0,8"/>
                                <Label Content="Phone Number:" 
                                       Padding="0,0,0,2"/>
                                <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding IsReadOnly}"
                                         Margin="0,0,0,8"/>
                                <Label Content="Email:" Padding="0,0,0,2"/>
                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding IsReadOnly}"
                                         Margin="0,0,0,0"/>
                                <Button Content="Apply" 
                                        Width="75" 
                                        Height="25"
                                        HorizontalAlignment="Left"
                                        Margin="0,50,0,0"
                                        Command="{Binding ApplyCommand}"
                                        Visibility="{Binding IsApplyVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Button Content="Clear Photo" 
                                        Width="75" 
                                        Height="25"
                                        HorizontalAlignment="Left"
                                        Margin="0,5,0,0"
                                        Command="{Binding ClearPhotoCommand}"
                                        Visibility="{Binding IsApplyVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>