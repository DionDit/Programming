<UserControl x:Class="View.UserControls.ContactUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:View.UserControls"
             xmlns:converters="clr-namespace:View.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="400">
    <UserControl.Resources>
        <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style TargetType="TextBox">
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <DockPanel LastChildFill="True">
                            <Border Background="Red" 
                                    Width="20" 
                                    Height="20" 
                                    DockPanel.Dock="Right"
                                    Margin="2,0,0,0"
                                    CornerRadius="10"
                                    ToolTip="{Binding ElementName='placeholder', Path=AdornedElement.(Validation.Errors)[0].ErrorContent}">
                                <TextBlock Text="!" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center" 
                                           FontWeight="Bold" 
                                           Foreground="White"/>
                            </Border>
                            <AdornedElementPlaceholder x:Name="placeholder"/>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="Background" Value="#FFE6B0B0"/>
                    <Setter Property="ToolTip" 
                            Value="{Binding RelativeSource={RelativeSource Self}, 
                                    Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0"
                Width="100"
                Height="100"
                Margin="0,18,10,0"
                VerticalAlignment="Top"
                Cursor="Hand"
                ToolTip="Нажмите для выбора фото"
                Background="Transparent"
                MouseLeftButtonDown="Border_MouseLeftButtonDown">
            <Grid>
                <Image Source="{Binding PhotoBytes, Converter={StaticResource ByteArrayToImageConverter}}"
                       Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Image Source="/photo_placeholder_100x100.png"
                       Width="100"
                       Height="100"
                       Stretch="UniformToFill"
                       Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"/>
            </Grid>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Top">
            <Label Content="Name:" Padding="0,0,0,2"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, 
                                   ValidatesOnNotifyDataErrors=True,
                                   ValidatesOnDataErrors=True,
                                   NotifyOnValidationError=True}"
                     Margin="0,0,0,8"
                     Padding="3"
                     IsEnabled="{Binding DataContext.IsEditingEnabled, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Label Content="Phone Number:" Padding="0,0,0,2"/>
            <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged,
                                   ValidatesOnNotifyDataErrors=True,
                                   ValidatesOnDataErrors=True,
                                   NotifyOnValidationError=True}"
                     Margin="0,0,0,8"
                     Padding="3"
                     DataObject.Pasting="TextBox_Pasting"
                     IsEnabled="{Binding DataContext.IsEditingEnabled, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Label Content="Email:" Padding="0,0,0,2"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged,
                                   ValidatesOnNotifyDataErrors=True,
                                   ValidatesOnDataErrors=True,
                                   NotifyOnValidationError=True}"
                     Margin="0,0,0,0"
                     Padding="3"
                     IsEnabled="{Binding DataContext.IsEditingEnabled, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>
    </Grid>
</UserControl>